# Режим выполнения команд: "local" (сервер запущен на Proxmox) или "ssh" (удалённо через SSH)
EXEC_MODE=local

# SSH настройки (только для EXEC_MODE=ssh)
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSWORD=  # альтернатива ключу

# Proxmox API (опционально, для структурированных операций)
# PVE_HOST=https://192.168.1.100:8006
# PVE_USER=root@pam
# PVE_TOKEN_NAME=mcp
# PVE_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PVE_VERIFY_SSL=false

# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8090
# AUTH_TOKEN=  # опционально, токен для защиты доступа
